AGENT_ENGINE=pydantic_ai

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1


# Si le LLM venait à passer à MISTRAL
MISTRAL_API_KEY=

# API de l'équipe data (lancée avec : uvicorn api:app --host 0.0.0.0 --port 8001)
DATA_API_URL=http://host.docker.internal:8001

DATA_API_FAKE=true